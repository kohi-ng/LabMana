rules_version = '2';
// ============================================================================
// LabMana — Firestore Rules v3 (Personal Workspace + Group Workspace + scoped RBAC + share ACL)
//
// Mô hình quyền (xem docs/ARCHITECTURE.md để biết ma trận đầy đủ):
//  - Phải đăng nhập bằng Email/Password (KHÔNG chấp nhận phiên ẩn danh).
//  - Tài khoản phải có users/{uid}.status == 'active' (Super Admin luôn được qua).
//  - Quyền nhóm đến từ memberships/{groupId}__{uid} (status active) VÀ groups/{groupId}.status == 'active'.
//  - Mỗi tài nguyên có scope = 'personal' | 'group'. Biết groupId KHÔNG tạo ra quyền.
//  - Chia sẻ chéo workspace chỉ qua resource_shares (Viewer, chỉ đọc, có thể hết hạn / thu hồi).
//
// Giới hạn: Rules không có vòng lặp và tối đa 10 lệnh get()/exists() cho mỗi request,
// nên mỗi tài nguyên được chia sẻ tối đa cho 2 nhóm + 50 người dùng.
// Rules KHÔNG phải bộ lọc: client phải truy vấn kèm where(scope/group_id/owner_uid) — xem js/workspace.js.
// ============================================================================
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------- Danh tính
    function signedIn() {
      return request.auth != null && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }
    function me() { return request.auth.uid; }
    // UID Super Admin: thay REPLACE_WITH_SUPER_ADMIN_UID bằng UID thật (cùng giá trị với js/config.js) trước khi Publish.
    function isSuperAdmin() { return signedIn() && request.auth.uid == 'REPLACE_WITH_SUPER_ADMIN_UID'; }
    function userPath(u) { return /databases/$(database)/documents/users/$(u); }
    function isActive() {
      return signedIn() && (isSuperAdmin()
        || (exists(userPath(request.auth.uid)) && get(userPath(request.auth.uid)).data.status == 'active'));
    }

    // ---------------------------------------------------------------- Nhóm / membership
    function groupPath(g) { return /databases/$(database)/documents/groups/$(g); }
    function memPath(g, u) { return /databases/$(database)/documents/memberships/$(g + '__' + u); }
    function isMember(g) {
      return exists(memPath(g, me()))
        && get(memPath(g, me())).data.status == 'active'
        && get(groupPath(g)).data.status == 'active';
    }
    function isGroupAdmin(g) { return isMember(g) && get(memPath(g, me())).data.role == 'group_admin'; }

    // ---------------------------------------------------------------- Tài nguyên (d = dữ liệu document)
    // Thấy/liệt kê: personal của chính mình, hoặc group mà mình là thành viên active.
    // Truy cập thuộc tính trực tiếp để Rules chứng minh được điều kiện list từ ràng buộc where() của query.
    // Document legacy (chưa có scope) → lỗi → từ chối; chúng được gán qua migration/migrate.mjs (Admin SDK).
    function inOwnWorkspace(d) {
      return (d.scope == 'personal' && d.owner_uid == me())
          || (d.scope == 'group' && isMember(d.group_id));
    }
    // Sửa/xóa: personal → chủ; group → Group Admin, hoặc thành viên là người tạo.
    function canManageRes(d) {
      return (d.scope == 'personal' && d.owner_uid == me())
          || (d.scope == 'group' && ((d.created_by == me() && isMember(d.group_id)) || isGroupAdmin(d.group_id)));
    }
    // Duyệt/thu hồi chia sẻ: chủ personal hoặc Group Admin của nhóm nguồn.
    function isShareApprover(d) {
      return (d.scope == 'personal' && d.owner_uid == me())
          || (d.scope == 'group' && isGroupAdmin(d.group_id));
    }
    // Tạo mới: client không được tự gán chủ/nhóm của người khác.
    function validNewRes(n) {
      return n.created_by == me() && n.owner_uid == me()
        && ((n.scope == 'personal' && n.group_id == null)
         || (n.scope == 'group' && n.group_id is string && isMember(n.group_id)))
        && n.get('shared_user_ids', []).size() == 0
        && n.get('shared_group_ids', []).size() == 0;
    }
    function ownerFieldsKept() {
      return request.resource.data.scope == resource.data.scope
          && request.resource.data.group_id == resource.data.group_id
          && request.resource.data.owner_uid == resource.data.owner_uid
          && request.resource.data.created_by == resource.data.created_by;
    }
    function shareFieldsKept() {
      return request.resource.data.get('shared_user_ids', []) == resource.data.get('shared_user_ids', [])
          && request.resource.data.get('shared_group_ids', []) == resource.data.get('shared_group_ids', []);
    }
    function shareFieldsBounded() {
      return request.resource.data.get('shared_user_ids', []).size() <= 50
          && request.resource.data.get('shared_group_ids', []).size() <= 2;
    }
    // runs / execution_logs phải cùng scope + nhóm với tài nguyên cha.
    function parentOK(coll, pid, n) {
      let p = get(/databases/$(database)/documents/$(coll)/$(pid)).data;
      return p.scope == n.scope && p.group_id == n.group_id
          && (n.scope == 'group' || p.owner_uid == n.owner_uid);
    }

    // ---------------------------------------------------------------- Chia sẻ (Viewer)
    function validShare(sid) {
      let p = /databases/$(database)/documents/resource_shares/$(sid);
      return exists(p)
        && get(p).data.status == 'active'
        && (get(p).data.get('expires_at', null) == null || get(p).data.expires_at > request.time);
    }
    function sharedToMeAsUser(rid, d) {
      return d.get('shared_user_ids', []).hasAny([me()]) && validShare('u_' + me() + '__' + rid);
    }
    function sharedToMeAsGroup(rid, d) {
      let g = d.get('shared_group_ids', []);
      return (g.size() > 0 && isMember(g[0]) && validShare('g_' + g[0] + '__' + rid))
          || (g.size() > 1 && isMember(g[1]) && validShare('g_' + g[1] + '__' + rid));
    }

    // ================================================================ users
    match /users/{u} {
      allow get: if signedIn() && (u == me() || isSuperAdmin());
      allow list: if isSuperAdmin();
      // Mặc định tài khoản mới = active (quyết định CẦN XÁC NHẬN: nếu muốn duyệt từng user, đổi thành 'pending').
      allow create: if signedIn() && u == me()
        && request.resource.data.uid == me()
        && request.resource.data.status == 'active'
        && request.resource.data.email == request.auth.token.email.lower();
      allow update: if signedIn() && (isSuperAdmin()
        || (u == me() && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['display_name', 'updated_at_ms', 'last_login_ms'])));
      allow delete: if false;
    }
    // Tra cứu uid theo email chính xác (để Group Admin thêm thành viên). Chỉ get, không list.
    match /user_emails/{email} {
      allow get: if isActive();
      allow create, update: if signedIn() && request.auth.token.email != null
        && email == request.auth.token.email.lower()
        && request.resource.data.uid == me();
      allow delete: if false;
    }

    // ================================================================ nhóm
    match /group_requests/{rid} {
      allow get, list: if isSuperAdmin() || (isActive() && resource.data.requested_by == me());
      allow create: if isActive()
        && request.resource.data.requested_by == me()
        && request.resource.data.status == 'pending'
        && request.resource.data.requested_name is string
        && request.resource.data.requested_name.size() >= 3
        && request.resource.data.requested_name.size() <= 80;
      allow update: if isSuperAdmin();
      allow delete: if false;
    }
    match /groups/{g} {
      allow get: if isSuperAdmin()
        || (signedIn() && exists(memPath(g, me())) && get(memPath(g, me())).data.status == 'active');
      allow list: if isSuperAdmin();
      allow create: if isSuperAdmin() && request.resource.data.status == 'active';
      allow update: if isSuperAdmin()
        || (isGroupAdmin(g) && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['name', 'description', 'updated_at_ms']));
      allow delete: if false;   // đình chỉ bằng status, không xóa vật lý
    }
    // Một nguồn sự thật cho role theo nhóm: memberships/{groupId}__{uid}
    match /memberships/{mid} {
      allow get, list: if isSuperAdmin()
        || (signedIn() && resource.data.uid == me())
        || (isActive() && isMember(resource.data.group_id));
      allow create: if isActive()
        && mid == request.resource.data.group_id + '__' + request.resource.data.uid
        && request.resource.data.status == 'active'
        && request.resource.data.added_by == me()
        && exists(userPath(request.resource.data.uid))
        && (isSuperAdmin()
            || (request.resource.data.role == 'member' && isGroupAdmin(request.resource.data.group_id)));
      allow update: if isActive()
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.group_id == resource.data.group_id
        && (isSuperAdmin()
            // Group Admin chỉ đổi trạng thái Member (không đụng role, không tự phong admin)
            || (isGroupAdmin(resource.data.group_id)
                && resource.data.role == 'member' && request.resource.data.role == 'member'
                && request.resource.data.status in ['active', 'revoked'])
            // Member tự rời nhóm
            || (resource.data.uid == me() && resource.data.role == 'member'
                && request.resource.data.role == 'member' && request.resource.data.status == 'left'));
      allow delete: if false;
    }
    match /workspace_settings/{key} {
      // key = 'personal_<uid>' hoặc 'group_<groupId>' (groupId là auto-ID, không chứa '_')
      allow get: if isActive() && (key == 'personal_' + me()
        || (key.split('_')[0] == 'group' && isMember(key.split('_')[1])));
      allow create, update: if isActive()
        && request.resource.data.keys().hasOnly(['team_members', 'team_ids', 'updated_at_ms'])
        && (key == 'personal_' + me()
            || (key.split('_')[0] == 'group' && isGroupAdmin(key.split('_')[1])));
      allow delete: if false;
    }

    // ================================================================ tài nguyên
    match /experiments/{id} {
      allow get: if isActive() && (inOwnWorkspace(resource.data)
        || sharedToMeAsUser(id, resource.data) || sharedToMeAsGroup(id, resource.data));
      allow list: if isActive() && inOwnWorkspace(resource.data);
      allow create: if isActive() && validNewRes(request.resource.data);
      allow update: if isActive()
        && ((canManageRes(resource.data) && ownerFieldsKept() && shareFieldsBounded()
             && (shareFieldsKept() || isShareApprover(resource.data))));
      allow delete: if isActive() && canManageRes(resource.data);
    }
    // runs / execution_logs là "sổ ghi chép chung" của nhóm: mọi thành viên active được tạo/ghi
    // (nhiều người cùng ghi vào 1 lượt, id cố định runId__stepId). QUYẾT ĐỊNH CẦN XÁC NHẬN —
    // muốn siết "chỉ người tạo mới sửa", đổi điều kiện update thành canManageRes(resource.data).
    match /runs/{id} {
      allow get, list: if isActive() && inOwnWorkspace(resource.data);
      allow create: if isActive() && validNewRes(request.resource.data)
        && parentOK('experiments', request.resource.data.exp_id, request.resource.data);
      allow update: if (isActive() && inOwnWorkspace(resource.data) && ownerFieldsKept());
      allow delete: if isActive() && canManageRes(resource.data);
    }
    match /execution_logs/{id} {
      allow get, list: if isActive() && inOwnWorkspace(resource.data);
      allow create: if isActive() && validNewRes(request.resource.data)
        && request.resource.data.executed_by_name is string
        && request.resource.data.step_id is string
        && request.resource.data.run_id is string
        && parentOK('runs', request.resource.data.run_id, request.resource.data);
      allow update: if (isActive() && inOwnWorkspace(resource.data) && ownerFieldsKept()
        && request.resource.data.executed_by_name is string
        && request.resource.data.step_id is string
        && request.resource.data.run_id is string);
      allow delete: if isActive() && canManageRes(resource.data);
    }

    // ================================================================ chia sẻ ACL
    // id = 'u_<uid>__<expId>' hoặc 'g_<groupId>__<expId>' (xác định → Rules kiểm tra bằng get()).
    match /resource_shares/{sid} {
      allow get, list: if isSuperAdmin()
        || (isActive() && (resource.data.created_by == me()
            || (resource.data.recipient_type == 'user' && resource.data.recipient_id == me())
            || (resource.data.recipient_type == 'group' && isMember(resource.data.recipient_id))
            || (resource.data.source_scope == 'group' && isGroupAdmin(resource.data.source_group_id))
            || (resource.data.source_scope == 'personal' && resource.data.source_owner_uid == me())));
      allow create: if isActive()
        && request.resource.data.resource_collection == 'experiments'
        && sid == (request.resource.data.recipient_type == 'user' ? 'u_' : 'g_')
                  + request.resource.data.recipient_id + '__' + request.resource.data.resource_id
        && request.resource.data.recipient_type in ['user', 'group']
        && request.resource.data.permission == 'read'
        && request.resource.data.created_by == me()
        && request.resource.data.source_scope == get(/databases/$(database)/documents/experiments/$(request.resource.data.resource_id)).data.scope
        && request.resource.data.source_group_id == get(/databases/$(database)/documents/experiments/$(request.resource.data.resource_id)).data.group_id
        && request.resource.data.source_owner_uid == get(/databases/$(database)/documents/experiments/$(request.resource.data.resource_id)).data.owner_uid
        && (request.resource.data.recipient_type == 'group' || exists(userPath(request.resource.data.recipient_id)))
        && ((request.resource.data.status == 'pending'
              && get(/databases/$(database)/documents/experiments/$(request.resource.data.resource_id)).data.scope == 'group'
              && get(/databases/$(database)/documents/experiments/$(request.resource.data.resource_id)).data.created_by == me()
              && isMember(request.resource.data.source_group_id))
            || (request.resource.data.status == 'active' && request.resource.data.approved_by == me()
              && isShareApprover(get(/databases/$(database)/documents/experiments/$(request.resource.data.resource_id)).data)));
      // Duyệt / từ chối / thu hồi: người duyệt của nhóm nguồn; người tạo yêu cầu chỉ được hủy yêu cầu pending.
      allow update: if isActive()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'approved_by', 'expires_at', 'updated_at_ms'])
        && ((request.resource.data.status in ['active', 'rejected', 'revoked'] && request.resource.data.approved_by == me()
              && ((resource.data.source_scope == 'personal' && resource.data.source_owner_uid == me())
                  || (resource.data.source_scope == 'group' && isGroupAdmin(resource.data.source_group_id))))
            || (resource.data.created_by == me() && resource.data.status == 'pending' && request.resource.data.status == 'revoked'));
      allow delete: if false;
    }

    // ================================================================ audit (chỉ thêm, không sửa/xóa)
    // Lưu ý: ghi từ client (không có backend). Không giả mạo được actor_uid nhưng không ép được "luôn ghi".
    match /audit_logs/{aid} {
      allow create: if isActive() && request.resource.data.actor_uid == me()
        && (request.resource.data.group_id == null
            || isSuperAdmin()
            || (request.resource.data.group_id is string && isGroupAdmin(request.resource.data.group_id)));
      allow get, list: if isSuperAdmin()
        || (isActive() && resource.data.group_id is string && isGroupAdmin(resource.data.group_id));
      allow update, delete: if false;
    }

    // ================================================================ config cũ (v2): chỉ Super Admin đọc để migrate
    match /config/{cid} {
      allow read: if isSuperAdmin();
      allow write: if false;
    }

    match /{document=**} { allow read, write: if false; }
  }
}
