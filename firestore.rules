rules_version = '2';
// Firestore Rules — chỉ cho phép người đã đăng nhập (kể cả ẩn danh) đọc/ghi các collection của LabMana.
service cloud.firestore {
  match /databases/{database}/documents {
    match /config/{id}          { allow read, write: if request.auth != null; }
    match /experiments/{id}     { allow read, write: if request.auth != null; }
    match /runs/{id}            { allow read, write: if request.auth != null; }
    match /execution_logs/{id}  {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.resource.data.executed_by_name is string
                   && request.resource.data.step_id is string
                   && request.resource.data.run_id is string;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
